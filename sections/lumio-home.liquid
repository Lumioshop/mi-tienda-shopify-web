{% style %}
  :root {
    --lumio-global-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    --lumio-global-bg-size: {{ section.settings.background_size }}%;
    --lumio-global-bg-blur: {{ section.settings.background_blur }}px;
  }
{% endstyle %}

{{ 'section-lumio-home.css' | asset_url | stylesheet_tag }}

<section class="lumio-landing" id="lumio-{{ section.id }}"{% if section.settings.background_image != blank %} style="--lumio-bg-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');"{% endif %}>
  <style>
    #lumio-{{ section.id }}::before {
      background-size: {{ section.settings.background_size }}% auto;
      filter: blur({{ section.settings.background_blur }}px);
    }
  </style>
  <div class="lumio-landing__hero">
    {% if section.settings.hero_banner != blank %}
      <a class="lumio-banner" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}" aria-label="Lumio">
        {{ section.settings.hero_banner | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800,1200,1600,2000,2400', class: 'lumio-banner__image', alt: 'Lumio' }}
      </a>
    {% else %}
      <div class="lumio-banner lumio-banner--placeholder"><span>Lumio</span><small>Sube aquí el banner de Lumio desde Personalizar → Imagen del banner</small></div>
    {% endif %}
  </div>

  <div class="lumio-products">
    <div class="lumio-products__header">
      <div><h2>Cosas que no sabías que necesitabas.</h2></div>
    </div>
    <div class="lumio-products__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <article class="lumio-card lumio-card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="lumio-card__visual">
            <span class="lumio-card__number">0{{ forloop.index }}</span>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', class: 'lumio-card__image', alt: block.settings.title | escape }}
            {% elsif product != blank and product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', class: 'lumio-card__image', alt: product.title | escape }}
            {% endif %}
            <span class="lumio-card__arrow">↗</span>
          </a>
          <div class="lumio-card__info"><div><span class="lumio-card__kicker">{{ block.settings.kicker }}</span><h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif product != blank %}{{ product.title }}{% endif %}</h3></div>{% if product != blank %}<strong>{{ product.price | money }}</strong>{% endif %}</div>
        </article>
      {% endfor %}
    </div>
  </div>
  <div class="lumio-marquee"><div><span>SMARTER EVERYDAY</span><i>✦</i><span>CURIOUS BY NATURE</span><i>✦</i><span>MADE FOR REAL LIFE</span><i>✦</i><span>SMARTER EVERYDAY</span><i>✦</i></div></div>
</section>

{% schema %}
{"name":"Lumio editorial home","tag":"section","class":"section-lumio-home","settings":[{"type":"image_picker","id":"hero_banner","label":"Banner principal de Lumio","info":"Sube aquí la imagen del banner que quieres usar en la cabecera."},{"type":"url","id":"hero_link","label":"Enlace del banner"},{"type":"image_picker","id":"background_image","label":"Fondo general de Lumio","info":"Imagen de fondo para toda la página."},{"type":"range","id":"background_size","label":"Tamaño del fondo","min":20,"max":200,"step":5,"unit":"%","default":100,"info":"Controla directamente el tamaño de la imagen de fondo."},{"type":"range","id":"background_blur","label":"Difuminado del fondo","min":0,"max":30,"step":1,"unit":"px","default":8,"info":"Controla directamente el desenfoque de la imagen de fondo."}],"blocks":[{"type":"product_card","name":"Product","settings":[{"type":"image_picker","id":"image","label":"Product image"},{"type":"product","id":"product","label":"Product"},{"type":"text","id":"kicker","label":"Kicker","default":"FEATURED"},{"type":"text","id":"title","label":"Title","default":"Producto Lumio"}]}],"max_blocks":3,"presets":[{"name":"Lumio editorial home","blocks":[{"type":"product_card"},{"type":"product_card"},{"type":"product_card"}]}]}
{% endschema %}
