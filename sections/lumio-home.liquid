{{ 'section-lumio-home.css' | asset_url | stylesheet_tag }}

<section class="lumio-home" id="lumio-home-{{ section.id }}">
  <div class="lumio-home__inner">
    <div class="lumio-home__intro">
      <span class="lumio-home__eyebrow">LUMIO / SMART EVERYDAY</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <a class="lumio-home__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} <span>→</span></a>
    </div>

    <div class="lumio-home__products">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <article class="lumio-product-card lumio-product-card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="lumio-product-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', class: 'lumio-product-card__image', alt: block.settings.title | escape }}
            {% elsif product != blank and product.featured_image != blank %}
              {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', class: 'lumio-product-card__image', alt: product.title | escape }}
            {% endif %}
            <span class="lumio-product-card__arrow">↗</span>
          </a>
          <div class="lumio-product-card__copy">
            {% if block.settings.kicker != blank %}<span>{{ block.settings.kicker }}</span>{% endif %}
            <h2>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif product != blank %}{{ product.title }}{% endif %}</h2>
            {% if product != blank %}<div class="lumio-product-card__price">{{ product.price | money }}</div>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="lumio-home__trust">
      <span>✦ Curated gadgets</span><span>✦ Designed for everyday life</span><span>✦ Secure checkout</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumio home hero",
  "tag": "section",
  "class": "section-lumio-home",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Tecnología que encaja en tu día."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Gadgets útiles, diseño limpio y pequeños descubrimientos que hacen la vida un poco mejor."},
    {"type":"text","id":"cta_label","label":"CTA label","default":"Descubrir Lumio"},
    {"type":"url","id":"cta_link","label":"CTA link"}
  ],
  "blocks": [
    {
      "type":"product_card",
      "name":"Product card",
      "settings":[
        {"type":"image_picker","id":"image","label":"Product image"},
        {"type":"product","id":"product","label":"Product"},
        {"type":"text","id":"kicker","label":"Kicker","default":"FEATURED"},
        {"type":"text","id":"title","label":"Title","default":"Producto destacado"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {"name":"Lumio home","blocks":[{"type":"product_card"},{"type":"product_card"},{"type":"product_card"}]}
  ]
}
{% endschema %}
